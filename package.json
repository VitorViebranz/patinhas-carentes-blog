{
    "name": "patinhas-carentes",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Website and staff panel for Patinhas Carentes Joinville",
    "engines": {
        "node": ">=22"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @patinhas/api\" \"npm run dev -w @patinhas/web\"",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "build": "npm run build --workspaces --if-present"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.5",
        "concurrently": "^10.0.6",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vitest": "^5.0.5"
    }
}
