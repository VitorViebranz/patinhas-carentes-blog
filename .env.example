# Copy to .env and fill in. Never commit .env.
# Variables are validated with Zod at API startup; a bad value stops the server with the field name.
# Docker Compose passes this whole file to the API container (env_file). It then forces HOST, PORT,
# NODE_ENV, DATABASE_URL, UPLOAD_DIR and TRUST_PROXY to the values the container needs.

# --- Docker (docker-compose.yml) -------------------------------------------------------------
# Password of the PostgreSQL user "postgres". Use only letters and digits (it goes into a URL).
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=postgres
# Ports used on this machine. Uncommon numbers on purpose, so they do not collide with other projects.
# Site published by Docker Compose (open http://localhost:<WEB_PORT>):
WEB_PORT=8847
# Address the site port is bound to. 127.0.0.1 keeps it reachable only from this machine (put a
# reverse proxy with HTTPS in front). Use 0.0.0.0 only to open it to your network on purpose.
WEB_BIND=127.0.0.1
# API published by Docker Compose on 127.0.0.1 only, for checks such as curl http://127.0.0.1:<API_PORT>/api/v1/health:
API_PORT=8848
# PostgreSQL published by docker-compose.dev.yml (container port stays 5432):
DB_PORT=54329
# Vite dev server (npm run dev). It stops with an error instead of picking another port:
WEB_DEV_PORT=5847
# Session cookies are Secure by default in production (HTTPS required, except on localhost).
# Set to false only to test over plain HTTP on a host that is not localhost.
# COOKIE_SECURE=true

# --- API ---------------------------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
# API port in development. The Vite dev server proxies /api to it.
PORT=3847
LOG_LEVEL=info
# Set to true behind Nginx, otherwise every client looks like the proxy to the rate limiter.
# Docker Compose already sets it for the API container.
TRUST_PROXY=false
RATE_LIMIT_MAX=120

# Database (create both: patinhas and patinhas_test). With Docker, the dev override creates them:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/patinhas
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/patinhas_test

# Session. At least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-with-32-plus-chars
SESSION_TTL_HOURS=24
# Extra origins allowed to send logged-in writes (CSRF check). The Vite dev server:
# ALLOWED_ORIGINS=http://localhost:5847
# Login attempts per minute (per IP and per e-mail), help requests per hour, geocoding per minute
AUTH_RATE_LIMIT_MAX=5
HELP_REQUEST_RATE_LIMIT_MAX=5
GEOCODE_RATE_LIMIT_MAX=10

# Uploads (images only). Keep this folder outside any public web root.
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5242880

# Geocoding (Nominatim). The User-Agent must identify the project and a way to contact you.
VIACEP_URL=https://viacep.com.br
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=PatinhasCarentesJoinville/1.0 (contato@seudominio.org)

# First admin, created by the seed command (password: 10+ characters).
#   local:  npm run db:seed -w @patinhas/api
#   docker: docker compose run --rm api npm run db:seed:prod
# Docker passes this whole file to the API container, so after the first seed delete
# SEED_ADMIN_PASSWORD from .env and run make up again: the password then stops being in the container.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
