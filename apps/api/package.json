{
    "name": "@patinhas/api",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file=../../.env src/server.ts",
        "start": "tsx src/server.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "db:generate": "prisma generate --no-hints --config prisma7.config.ts",
        "db:migrate": "prisma migrate dev --config prisma7.config.ts",
        "db:deploy": "prisma migrate deploy --config prisma7.config.ts",
        "db:seed": "tsx --env-file=../../.env src/seed/main.ts",
        "db:seed:prod": "tsx src/seed/main.ts",
        "db:neighborhoods": "tsx --env-file=../../.env src/seed/sync-neighborhoods-main.ts",
        "db:neighborhoods:prod": "tsx src/seed/sync-neighborhoods-main.ts"
    },
    "dependencies": {
        "@fastify/cookie": "^11.1.3",
        "@fastify/helmet": "^13.2.0",
        "@fastify/multipart": "^10.1.6",
        "@fastify/rate-limit": "^11.2.1",
        "@fastify/swagger": "^9.9.2",
        "@fastify/swagger-ui": "^6.1.2",
        "@patinhas/shared": "*",
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "fastify": "^5.12.7",
        "fastify-plugin": "^6.0.1",
        "fastify-type-provider-zod": "^7.0.0",
        "pg": "^8.23.1",
        "pino": "^10.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/pg": "^8.23.1",
        "dotenv": "^18.0.9",
        "prisma": "^7.10.1",
        "tsx": "^4.23.15"
    }
}
