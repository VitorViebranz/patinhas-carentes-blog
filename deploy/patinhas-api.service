[Unit]
Description=Patinhas Carentes API
After=network.target postgresql.service

[Service]
Type=simple
User=patinhas
WorkingDirectory=/opt/patinhas/apps/api
EnvironmentFile=/etc/patinhas/api.env
ExecStart=/usr/bin/node --import tsx src/server.ts
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/patinhas
PrivateTmp=true

[Install]
WantedBy=multi-user.target
